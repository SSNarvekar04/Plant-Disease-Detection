# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` (same folder as server.js) and fill in real values.
# NEVER commit the real `.env` file to Git -- it is already in .gitignore.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
#   Local Atlas (recommended): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/plant_disease?retryWrites=true&w=majority
#   Local mongod:            mongodb://127.0.0.1:27017/plant_disease
MONGO_URI=mongodb://127.0.0.1:27017/plant_disease

# Secret used to sign JWT tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# Set to "development" while testing locally, "production" when deployed.
NODE_ENV=development

# Base URL of the React app, used for CORS. Comma-separate for multiple origins.
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Cloudinary (image storage) -- https://console.cloudinary.com/settings/api-keys
# Leave blank to run in "local disk" mode (files are saved to backend/uploads).
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=plant-disease

# ---------------------------------------------------------------------------
# Python ML service -- see ml-service/.env.example
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=45000

# Set to "true" to allow the deterministic mock classifier when the ML service
# is unreachable. Handy for demos, keep "false" in production.
ALLOW_MOCK_PREDICTION=true

# ---------------------------------------------------------------------------
# Seed script (`npm run seed`) -- the admin account it creates.
# Change the password before seeding anything you care about.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@plantdisease.com
SEED_ADMIN_PASSWORD=Admin@123
