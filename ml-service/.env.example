# ---------------------------------------------------------------------------
# ML service environment variables
# Copy this file to `ml-service/.env` and adjust if needed.
# All values here are safe local defaults -- nothing secret belongs in this file.
# ---------------------------------------------------------------------------

# Port the FastAPI service listens on. Must match ML_SERVICE_URL in backend/.env.
ML_PORT=8000

# Path to the trained Keras model.
# Default location expected by app.py: ml-service/models/plant_disease_cnn.keras
# Produce it with:  python train.py
# An absolute path is also accepted, e.g. D:/models/plant_disease_cnn.keras
MODEL_PATH=models/plant_disease_cnn.keras

# When "true" and no trained model file is present, /predict uses the
# deterministic mock classifier so the application stays demo-able.
# Set to "false" to return HTTP 503 instead of a fallback result.
ML_ALLOW_MOCK=true

# Maximum accepted upload size in megabytes.
ML_MAX_FILE_SIZE_MB=8