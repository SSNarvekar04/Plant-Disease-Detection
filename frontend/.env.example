# ---------------------------------------------------------------------------
# Frontend environment variables
# Copy this file to `frontend/.env` (already done for you if you ran the setup).
#
# IMPORTANT: NEVER put a secret here. The frontend code is shipped to the
# browser, so only public, non-sensitive values belong in this file.
# MONGO_URI, JWT_SECRET and the Cloudinary keys stay in backend/.env.
# ---------------------------------------------------------------------------

# Base URL of the Node/Express API.
# Leave as "/" to use the Vite dev proxy (same origin, no CORS needed).
# Set to "http://localhost:5000" to call the API directly.
VITE_API_URL=/

# Name shown in the navbar and page title.
VITE_APP_NAME=Plant Disease Detection

# Optional comma-separated list of allowed origins. Only needed when the
# backend and frontend run on different ports without the dev proxy.
# VITE_ALLOWED_ORIGINS=http://localhost:5173